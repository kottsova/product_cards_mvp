{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-cards-source-catalog-v2",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 2},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "adapter_id", "brands", "category_groups", "category_patterns",
          "markets", "source_country", "source_locale", "source_languages", "market_scope",
          "identity_scope", "source_role", "candidate_url", "page_hosts", "support_hosts",
          "asset_document_hosts", "capabilities", "identity_strategy", "priority",
          "official_status", "access_status", "fingerprint_status", "adapter_status",
          "lifecycle_status", "host_verification", "enabled", "last_checked_at", "evidence"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "adapter_id": {"type": "string", "minLength": 1},
          "brands": {"type": "array", "items": {"type": "string"}},
          "category_groups": {"type": "array", "items": {"type": "string"}},
          "category_patterns": {"type": "array", "items": {"type": "string"}},
          "category_allowlist": {"type": "array", "items": {"type": "string"}},
          "category_deny_patterns": {"type": "array", "items": {"type": "string"}},
          "category_review_patterns": {"type": "array", "items": {"type": "string"}},
          "markets": {"type": "array", "items": {"type": "string"}},
          "source_country": {"type": "string"},
          "source_locale": {"type": "string"},
          "source_languages": {"type": "array", "items": {"type": "string"}},
          "market_scope": {"enum": ["unknown", "global", "regional", "country", "local"]},
          "identity_scope": {"enum": ["unknown", "family_only", "exact_product"]},
          "regional_product_code": {"type": "string"},
          "source_role": {"enum": ["manufacturer", "support", "dealer", "retailer"]},
          "candidate_url": {"type": "string"},
          "page_hosts": {"type": "array", "items": {"type": "string"}},
          "support_hosts": {"type": "array", "items": {"type": "string"}},
          "asset_document_hosts": {"type": "array", "items": {"type": "string"}},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "identity_strategy": {"type": "string"},
          "priority": {"type": "integer"},
          "official_status": {"enum": ["research_pending", "candidate", "official_verified", "third_party_confirmed", "not_allowed", "rejected"]},
          "access_status": {"enum": ["not_checked", "direct_access", "structured_api", "javascript_required", "browser_assisted", "search_only", "rate_limited", "captcha_or_blocked", "regional_redirect", "support_only", "legacy_missing", "unavailable"]},
          "fingerprint_status": {"enum": ["not_checked", "insufficient", "probable", "confirmed", "conflict"]},
          "adapter_status": {"enum": ["not_started", "research_pending", "recommended", "legacy_compatibility", "ready"]},
          "lifecycle_status": {"enum": ["candidate", "official_verified", "access_checked", "fingerprinted", "sampled", "adapter_ready", "enabled", "disabled"]},
          "host_verification": {"enum": ["not_checked", "verified", "rejected"]},
          "enabled": {"type": "boolean"},
          "last_checked_at": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "http_status": {"type": ["integer", "null"]},
          "redirect_chain": {"type": "array", "items": {"type": "string"}},
          "robots_status": {"type": "string"},
          "sitemap_status": {"type": "string"},
          "javascript_required": {"type": ["boolean", "null"]},
          "protection_status": {"type": "string"},
          "product_search_available": {"type": ["boolean", "null"]},
          "platform_fingerprints": {"type": "array", "items": {"type": "object"}},
          "fingerprint_layers": {"type": "array", "items": {"type": "object"}},
          "presumed_engine": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "sample_urls": {"type": "array", "items": {"type": "string"}},
          "probe_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "capability", "sample_type"],
              "properties": {
                "url": {"type": "string"},
                "capability": {"enum": ["homepage", "robots_txt", "sitemap", "category_page", "internal_search", "product_page", "support_page", "document_endpoint", "asset_host", "structured_api"]},
                "sample_type": {"type": "string"},
                "expected_models": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "endpoints": {"type": "array", "items": {"type": "object"}},
          "adapter_recommendation": {"type": "string"},
          "fallback_sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
