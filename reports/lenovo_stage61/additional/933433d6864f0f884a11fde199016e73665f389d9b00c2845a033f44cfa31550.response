{"code":1,"data":{"ProductID":2402,"ProductName":"ThinkPad X1 Carbon Gen 12","ProductKey":"ThinkPad_X1_Carbon_Gen_12","SpecData":[{"title":"PERFORMANCE","name":"Processor","note":[],"content":["Intel Core&trade; Ultra 7 155U, 12C (2P + 8E + 2LPE) / 14T, Max Turbo up to 4.8GHz, 12MB Intel&reg; Smart Cache"]},{"value_note":{"0":"AI PCs have a NPU capable of 10+ TOPs to run the Copilot assistant by pressing the optional Microsoft Copilot key or using Win + C."},"name":"AI PC Category","note":["AI PCs have a NPU capable of 10+ TOPs to run the Copilot assistant by pressing the optional Microsoft Copilot key or using Win + C."],"content":["AI PC"]},{"name":"NPU","note":[],"content":["Integrated Intel&reg; AI Boost, up to 11 TOPS"]},{"name":"Graphics","note":[],"content":["Integrated Intel&reg; Graphics"]},{"name":"Chipset","note":[],"content":["Intel&reg; SoC Platform"]},{"value_note":{"0":"Installed memory is actually LPDDR5X-7500 but runs as LPDDR5X-6400 due to platform limitation."},"name":"Memory","note":["Installed memory is actually LPDDR5X-7500 but runs as LPDDR5X-6400 due to platform limitation."],"content":["16GB Soldered LPDDR5X-6400"]},{"name":"Memory Slots","note":[],"content":["Memory soldered to systemboard, no slots, 8-channel"]},{"name":"Max Memory","note":[],"content":["16GB soldered memory, not upgradable"]},{"name":"Storage","note":[],"content":["512GB SSD M.2 2280 PCIe&reg; 4.0x4 Performance NVMe&reg; Opal 2.0"]},{"name":"Storage Slot","note":[],"content":["One M.2 2280 PCIe&reg; 4.0 x4 slot"]},{"feature_note":["The storage capacity supported is based on the test results with current Lenovo storage offerings."],"name":"Max Storage Support","note":["The storage capacity supported is based on the test results with current Lenovo storage offerings."],"content":["One drive, up to 2TB M.2 2280 SSD"]},{"name":"Optical","note":[],"content":["None"]},{"name":"Card Reader","note":[],"content":["No Card Reader"]},{"name":"Audio Chip","note":[],"content":["High Definition (HD) Audio, Realtek&reg; ALC3306 codec"]},{"name":"Speakers","note":[],"content":["Stereo speakers, 2W x2, Dolby Atmos&reg;"]},{"name":"Microphone","note":[],"content":["2x, Array"]},{"name":"Camera","note":[],"content":["UHD 8.0MP + IR Discrete with Privacy Shutter, MIPI, Computer Vision"]},{"name":"Battery","note":[],"content":["57Wh"]},{"name":"Power Adapter","note":[],"content":["65W USB-C&reg; Slim (3-pin)"]},{"title":"DESIGN","name":"Display","note":[],"content":["14\" 2.8K (2880x1800) OLED 400nits Anti-glare / Anti-reflection / Anti-smudge, 100% DCI-P3, 120Hz, DisplayHDR&trade; True Black 500, Dolby Vision&reg;, Touch"]},{"name":"Touchscreen","note":[],"content":["Add-on Film Touch, 10-point Multi-touch"]},{"name":"Screen-to-Body Ratio","note":[],"content":["89.2%"]},{"name":"Pen","note":[],"content":["Pen Not Supported"]},{"name":"Keyboard","note":[],"content":["Backlit, English (EU)"]},{"name":"Touchpad","note":[],"content":["Haptic Touchpad"]},{"feature_note":["The system dimensions may vary depending on configurations."],"name":"Dimensions (WxDxH)","note":["The system dimensions may vary depending on configurations."],"content":["312.80 x 214.75 x 14.96 mm (12.31 x 8.45 x 0.59 inches)"]},{"feature_note":["The system weight is approximate and based on results in Lenovo lab, which varies depending on the source of component, variance of the distribution of each component, and manufacturing process. It may not be the exact weight for each specific model."],"name":"Weight","note":["The system weight is approximate and based on results in Lenovo lab, which varies depending on the source of component, variance of the distribution of each component, and manufacturing process. It may not be the exact weight for each specific model."],"content":["Starting at 1.09 kg (2.40 lbs)"]},{"name":"Case Color","note":[],"content":["Black, Paint"]},{"name":"Case Material","note":[],"content":["Carbon Fiber (Top), Aluminium (Bottom)"]},{"title":"SOFTWARE","name":"Op